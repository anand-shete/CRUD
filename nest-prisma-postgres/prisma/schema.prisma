generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @unique @default(uuid()) @db.Uuid
  name     String
  email    String @unique
  password String
  Blog     Blog[]
}

model Blog {
  id          String @id @unique @default(uuid()) @db.Uuid
  title       String
  description String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String @db.Uuid
}
